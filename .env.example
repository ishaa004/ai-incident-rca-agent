# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rca_agent
POSTGRES_USER=rca_agent
POSTGRES_PASSWORD=rca_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Kafka (optional for local dev — file-based seeding works without it)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=incident.events
KAFKA_CONSUMER_GROUP=rca-agent

# App
LOG_LEVEL=INFO
MAX_PARALLEL_AGENTS=3
RETRIEVAL_TOP_K=5
